/* pages/index/index.wxss */
page {
  background-color: #F8FAFC;
  height: 100%;
}

.home-page {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

/* 顶部紫罗兰渐变 Header 区域 */
.header-card {
  width: 100%;
  padding: 60rpx 40rpx 70rpx 40rpx;
  background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 50%, #9333EA 100%);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  box-shadow: 0 16rpx 40rpx rgba(124, 58, 237, 0.2);
  box-sizing: border-box;
}

.brand-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.brand-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 1rpx;
}

/* 工具箱标题分界行 */
.section-header {
  padding: 36rpx 36rpx 20rpx 36rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
}

/* 2x4 平衡布局工具网格 */
.tools-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 32rpx;
}

.tool-card {
  width: 47.5%;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(148, 163, 184, 0.08);
  transition: all 0.2s ease;
}

.tool-card:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(148, 163, 184, 0.12);
}

/* 图标背景彩盒 */
.icon-badge {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.card-emoji {
  font-size: 48rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F172A;
  text-align: center;
}

/* 丰富精致背景调色 */
.icon-bg-violet {
  background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%);
}

.icon-bg-pink {
  background: linear-gradient(135deg, #FCE7F3 0%, #FBCFE8 100%);
}

.icon-bg-orange {
  background: linear-gradient(135deg, #FFEDD5 0%, #FED7AA 100%);
}

.icon-bg-blue {
  background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
}

.icon-bg-green {
  background: linear-gradient(135deg, #DCFCE7 0%, #BBF7D0 100%);
}

.icon-bg-amber {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
}

.icon-bg-teal {
  background: linear-gradient(135deg, #CCFBF1 0%, #99F6E4 100%);
}

.icon-bg-purple {
  background: linear-gradient(135deg, #F3E8FF 0%, #E9D5FF 100%);
}

/* 底部版权文案 */
.footer-copy {
  text-align: center;
  font-size: 24rpx;
  color: #94A3B8;
  padding: 40rpx 0 60rpx 0;
}
